# firmware, images and build output stay out of git
*.img
*.img.xz
*.bin
*.zip
*.apk
*.idsig
*.jks
*.keystore
*.pk8
*.x509.pem
platformkey/
# WireGuard configs hold private keys
*.conf
final_*/
preview_*/
__pycache__/
# raw device logs contain MACs and network names; only the filtered ones are committed
dmesg*.txt
logcat*.txt
